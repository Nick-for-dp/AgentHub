# 前端部署 profile 必须与后端 DEPLOYMENT_PROFILE 保持一致。
# external: 外部客户问答；internal: 内部合同审查等工作台。
VITE_DEPLOYMENT_PROFILE=external

# 双profile发布时可指定独立输出目录，例如 dist/external 或 dist/internal。
# 普通单实例构建不设置，继续输出到 dist。
VITE_BUILD_OUT_DIR=

# 本地开发 API 反向代理目标。
VITE_API_HOST=127.0.0.1
VITE_API_PORT=8240

# 合同审查 blocking execute 的浏览器等待上限（毫秒）。
VITE_CONTRACT_REVIEW_EXECUTE_TIMEOUT_MS=600000

# iframe 父页面 origin 白名单，逗号分隔；不要与普通 API CORS 混用。
VITE_EMBED_ALLOWED_PARENT_ORIGINS=
