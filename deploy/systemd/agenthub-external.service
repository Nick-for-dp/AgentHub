[Unit]
Description=AgentHub External Backend
Documentation=file:/opt/agenthub/repo/deploy/single-host-dual-profile.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=agenthub-external
Group=agenthub-external
WorkingDirectory=/opt/agenthub/repo/backend
EnvironmentFile=/etc/agenthub/external.env
ExecStartPre=/usr/bin/test "${DEPLOYMENT_PROFILE}" = external
ExecStartPre=/usr/bin/test -x /opt/agenthub/venvs/external/bin/python
ExecStart=/opt/agenthub/venvs/external/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8240 --proxy-headers --forwarded-allow-ips=127.0.0.1
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenthub-external

[Install]
WantedBy=multi-user.target
