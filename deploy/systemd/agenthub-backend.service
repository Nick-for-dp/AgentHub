# AgentHub 后端 systemd unit
#
# 部署位置：/etc/systemd/system/agenthub-backend.service
# 应用部署位置约定：/opt/agenthub/backend
# 运行用户约定：agenthub（系统用户，无登录 shell）
# uv 路径约定：/usr/local/bin/uv（如装在别处，修改 ExecStart）
#
# 启停命令：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agenthub-backend
#   sudo systemctl status agenthub-backend
#   sudo journalctl -u agenthub-backend -f          # 实时日志
#
# 设计说明：
#   - 监听 127.0.0.1:8240，外部访问必须经 Nginx 反代（见 deploy/nginx/agenthub.conf）。
#   - 数据库迁移不放在启动里，由人工 `uv run alembic upgrade head` 显式执行，
#     失败时立即可见，避免被服务启动失败掩盖。
#   - Restart=on-failure 配合 StartLimitBurst 防止失败时无限重启烧 CPU。
#   - LimitNOFILE 提到 65536 是因为 SSE 长连接会占用较多 fd。

[Unit]
Description=AgentHub Backend (FastAPI / uvicorn)
Documentation=https://github.com/wukehan/AgentHub
# 等网络就绪后再起。本项目 MySQL 部署在异机（10.128.140.211:3306），
# 因此不依赖本机 mysql.service；如改为 MySQL 同机部署，加回 After=mysql.service。
After=network-online.target
Wants=network-online.target
# 失败重启上限：30 秒窗口内失败 5 次后暂停，防止死循环烧 CPU。
# 注意：systemd 220+ 起 StartLimitIntervalSec/StartLimitBurst 必须放在 [Unit]，
# 写在 [Service] 会被忽略并报 "Unknown key name" 警告。
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=agenthub
Group=agenthub
WorkingDirectory=/opt/agenthub/backend

# 环境变量从 .env 加载；该文件权限应为 600，owner=agenthub。
EnvironmentFile=/opt/agenthub/backend/.env

# uv 写死 /usr/local/bin/uv：systemd 不读 shell rc，依赖 PATH 会失败。
# --host 127.0.0.1 是硬约束：外部只能经 Nginx 进来。
ExecStart=/usr/local/bin/uv run uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8240 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1

# 优雅停机：先发 SIGTERM，超时再 SIGKILL。SSE 流可在 30 秒内自然收尾。
KillSignal=SIGTERM
TimeoutStopSec=30

# 失败重启策略：失败后 5 秒后自动重启。
# StartLimitIntervalSec / StartLimitBurst 上限保护放在 [Unit] 段（systemd 220+ 要求）。
Restart=on-failure
RestartSec=5

# SSE 长连接需要更多文件描述符。
LimitNOFILE=65536

# 安全加固（systemd 沙箱）：
# - 不允许提升权限
# - 私有 /tmp，避免与其他服务串扰
# - 隐藏其他用户的进程信息
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# 日志走 journald；轮转由 systemd-journald 自带能力承担（见 deploy/logrotate/）。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenthub-backend

[Install]
WantedBy=multi-user.target
