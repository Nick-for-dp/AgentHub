# AgentHub external profile — single-host trial template
# Copy to /etc/agenthub/external.env, replace every change-me/example value,
# then chown root:agenthub and chmod 0640. Never commit the real file.

APP_NAME=AgentHub External
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
DEPLOYMENT_PROFILE=external
API_V1_PREFIX=/api/v1
SERVER_HOST=127.0.0.1
SERVER_PORT=8240
FRONTEND_PORT=8080
PUBLIC_ORIGIN=http://192.0.2.10:8080
LOG_LEVEL=INFO

# Deployment-only paths consumed by preflight/run scripts (Settings ignores them).
RELEASE_ROOT=/opt/agenthub/current-external
PYTHON_BIN=/opt/agenthub/venvs/external/bin/python
FRONTEND_ROOT=/opt/agenthub/frontend-dist/external/current
JOURNAL_IDENTIFIER=agenthub-external
NGINX_ACCESS_LOG=/var/log/nginx/agenthub-external.access.log
NGINX_ERROR_LOG=/var/log/nginx/agenthub-external.error.log

# Remote MySQL. external/internal must use different schemas and users.
DATABASE_URL=mysql+pymysql://agenthub_ext:change-me-db-password@mysql.intra:3306/agenthub?charset=utf8mb4
REDIS_URL=redis://redis.intra:6379/0

# Generate each secret independently; never reuse values across profiles.
API_KEY_SIGNING_SECRET=change-me-external-api-key-signing-secret
AUTH_TOKEN_SECRET=change-me-external-auth-token-secret-at-least-32-characters
AUTH_COOKIE_NAME=agenthub_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# IP access must remain host-only.
AUTH_COOKIE_DOMAIN=
ACCESS_TOKEN_EXPIRE_MINUTES=20
SESSION_IDLE_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Same-origin browser access. Include the actual IP and external frontend port.
CORS_ALLOWED_ORIGINS=http://192.0.2.10:8080

# Keep disabled unless the marketing iframe integration is explicitly tested.
EMBED_ENABLED=false
EMBED_EXTERNAL_TOKEN_SECRET=change-me-external-embed-token-secret
EMBED_EXTERNAL_TOKEN_ISSUER=industrial-internet
EMBED_EXTERNAL_TOKEN_AUDIENCE=agenthub-external
EMBED_SESSION_COOKIE_NAME=agenthub_embed_session
EMBED_COOKIE_SECURE=false
EMBED_COOKIE_SAMESITE=lax
EMBED_COOKIE_DOMAIN=
EMBED_ALLOWED_PARENT_ORIGINS=
EMBED_DEFAULT_AGENT_CODE=qa

# Dify may share a host with internal, but App/API Key values must be different.
DIFY_BASE_URL=http://dify.intra:8200/v1
DIFY_API_KEY=change-me-external-dify-api-key
CONTRACT_REVIEW_DIFY_API_KEY=
CONTRACT_REVIEW_FULL_CONTEXT_DIFY_API_KEY=
CONTRACT_REVIEW_BLOCK_LOOP_DIFY_API_KEY=

# MinIO may share a host, but service account and buckets must be external-only.
OBJECT_STORAGE_ENDPOINT=http://minio.intra:9000
OBJECT_STORAGE_ACCESS_KEY=change-me-external-minio-access-key
OBJECT_STORAGE_SECRET_KEY=change-me-external-minio-secret-key
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET_RAW=ext-agenthub-raw
OBJECT_STORAGE_BUCKET_PARSED=ext-agenthub-parsed
OBJECT_STORAGE_PRESIGN_EXPIRES_SECONDS=900
MINIO_CORS_ALLOWED_ORIGINS=http://192.0.2.10:8080

# Profile-aware seed inputs. Production seed output never prints these secrets.
SEED_ADMIN_PHONE=+8613900000000
SEED_ADMIN_PASSWORD=change-me-external-admin-password
SEED_EXT_PHONE=+8613800001234
SEED_EXT_PASSWORD=change-me-external-demo-password
SEED_EXT2_PHONE=+8613800005678
SEED_EXT2_PASSWORD=change-me-external-demo2-password
SEED_RUNTIME_APP_ID=change-me-external-dify-app-id
SEED_PROVIDER_KB_ID=change-me-external-kb-id
