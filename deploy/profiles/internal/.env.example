# AgentHub internal profile — single-host trial template
# Copy to /etc/agenthub/internal.env, replace every change-me/example value,
# then chown root:root and chmod 0600. Never commit the real file.

APP_NAME=AgentHub Internal
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
DEPLOYMENT_PROFILE=internal
API_V1_PREFIX=/api/v1
SERVER_HOST=127.0.0.1
SERVER_PORT=8241
FRONTEND_PORT=8081
PUBLIC_ORIGIN=http://192.0.2.10:8081
LOG_LEVEL=INFO

# Remote MySQL. external/internal must use different schemas and users.
DATABASE_URL=mysql+pymysql://agenthub_int:change-me-db-password@mysql.intra:3306/agenthub_internal?charset=utf8mb4
REDIS_URL=redis://redis.intra:6379/1

# Generate each secret independently; never reuse values across profiles.
API_KEY_SIGNING_SECRET=change-me-internal-api-key-signing-secret
AUTH_TOKEN_SECRET=change-me-internal-auth-token-secret-at-least-32-characters
AUTH_COOKIE_NAME=agenthub_internal_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# IP access must remain host-only.
AUTH_COOKIE_DOMAIN=
ACCESS_TOKEN_EXPIRE_MINUTES=20
SESSION_IDLE_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# The internal frontend origin must include its actual port.
CORS_ALLOWED_ORIGINS=http://192.0.2.10:8081
# Comma-separated company LAN/VPN CIDRs. Deployment must fail until replaced.
INTERNAL_ALLOWED_CIDRS=change-me-to-company-or-vpn-cidr

# Internal iframe/embed is disabled by default.
EMBED_ENABLED=false
EMBED_EXTERNAL_TOKEN_SECRET=change-me-internal-embed-token-secret
EMBED_EXTERNAL_TOKEN_ISSUER=agenthub-internal-issuer
EMBED_EXTERNAL_TOKEN_AUDIENCE=agenthub-internal
EMBED_SESSION_COOKIE_NAME=agenthub_internal_embed_session
EMBED_COOKIE_SECURE=false
EMBED_COOKIE_SAMESITE=lax
EMBED_COOKIE_DOMAIN=
EMBED_ALLOWED_PARENT_ORIGINS=
EMBED_DEFAULT_AGENT_CODE=contract-review

# Internal Dify App/API Key must not be shared with external.
DIFY_BASE_URL=http://dify.intra:8300/v1
DIFY_API_KEY=
CONTRACT_REVIEW_DIFY_API_KEY=change-me-internal-contract-review-dify-key
CONTRACT_REVIEW_FULL_CONTEXT_DIFY_API_KEY=
CONTRACT_REVIEW_BLOCK_LOOP_DIFY_API_KEY=

# MinIO service account and buckets are internal-only.
OBJECT_STORAGE_ENDPOINT=http://minio.intra:9000
OBJECT_STORAGE_ACCESS_KEY=change-me-internal-minio-access-key
OBJECT_STORAGE_SECRET_KEY=change-me-internal-minio-secret-key
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET_RAW=int-agenthub-raw
OBJECT_STORAGE_BUCKET_PARSED=int-agenthub-parsed
OBJECT_STORAGE_PRESIGN_EXPIRES_SECONDS=900
MINIO_CORS_ALLOWED_ORIGINS=http://192.0.2.10:8081

# Cloud document extraction remains fail-closed until data-egress approval.
RISK_DOCUMENT_EXTRACTION_PROVIDER=paddleocr_qwen
RISK_DOCUMENT_CLOUD_EGRESS_ENABLED=false
RISK_DOCUMENT_PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
RISK_DOCUMENT_PADDLEOCR_API_TOKEN=
RISK_DOCUMENT_PADDLEOCR_MODEL=PaddleOCR-VL-1.6
# * 只匹配单个 DNS 标签内部，用于兼容 PaddleOCR 动态编号的结果 bucket。
RISK_DOCUMENT_PADDLEOCR_RESULT_HOSTS=paddleocr-store-*.bj.bcebos.com
RISK_DOCUMENT_QWEN_BASE_URL=
RISK_DOCUMENT_QWEN_API_KEY=
RISK_DOCUMENT_QWEN_MODEL=qwen3.7-plus
RISK_DOCUMENT_QWEN_INPUT_MODE=ocr_text

# Profile-aware seed inputs. Production seed output never prints passwords/keys.
SEED_ADMIN_PHONE=+8613910000000
SEED_ADMIN_PASSWORD=change-me-internal-admin-password
CONTRACT_REVIEW_RUNTIME_APP_ID=change-me-internal-contract-review-app-id
