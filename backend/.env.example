# AgentHub 环境变量
# 复制此文件为 .env 后修改

# 应用
APP_NAME=AgentHub
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
SERVER_PORT=8240
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://host:6379/0

# API Key 签名密钥（至少 16 字符，需使用高强度随机字符串）
API_KEY_SIGNING_SECRET=change-me-to-a-random-secret

# 官网嵌入
EMBED_ENABLED=true
# 生产环境必须显式配置两组不同的高强度随机密钥，至少 32 字符，不能使用示例/开发占位值。
EMBED_SERVER_JWT_SECRET=replace-with-random-embed-server-jwt-secret
EMBED_ACCESS_TOKEN_SECRET=replace-with-random-embed-access-token-secret
EMBED_TOKEN_ISSUER=agenthub-embed
EMBED_ACCESS_TOKEN_EXPIRE_MINUTES=15
EMBED_SESSION_EXPIRE_HOURS=12
EMBED_DEFAULT_AGENT_CODE=qa
EMBED_DEFAULT_ORG_NAME=官网嵌入用户
EMBED_OFFICIAL_INTROSPECT_URL=
EMBED_OFFICIAL_INTROSPECT_SECRET=
EMBED_ALLOWED_PARENT_ORIGINS=

# Dify（可选，不填则 Q&A 返回 mock 应答）
DIFY_BASE_URL=
DIFY_API_KEY=

# 火山引擎语音（新版控制台，使用 X-Api-Key）
VOLC_AUDIO_API_KEY=
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
VOLC_ASR_AUDIO_FORMAT=pcm
VOLC_ASR_SAMPLE_RATE=16000
VOLC_ASR_LANGUAGE=zh-CN
VOLC_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=
VOLC_TTS_AUDIO_FORMAT=mp3
VOLC_TTS_SAMPLE_RATE=24000
