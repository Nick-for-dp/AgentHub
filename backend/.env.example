# AgentHub 后端环境变量模板（开发 / 生产 通用）
#
# 用法：
#   1) 复制为 .env：cp .env.example .env
#   2) 按下方注释填写真实值
#   3) 生产环境（ENVIRONMENT=production）必须替换密钥，弱密钥会导致启动失败
#
# 安全红线（Agent.md 第 5 / 7 节）：
#   - 真实密钥**只**写进 .env，绝不进 git / 日志 / 调用记录 / 错误响应
#   - 生产服务器：chown agenthub:agenthub /opt/agenthub/backend/.env && chmod 600
#   - 密钥生成命令：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ENVIRONMENT 取值：
#   - local       本地开发，密钥校验宽松
#   - production  生产，触发强校验：密钥 ≥ 32 字符且不得含 change-me/dev-/example/placeholder 等占位标记

# ─────────────────────────────────────────────
# 1. 应用基础
# ─────────────────────────────────────────────
APP_NAME=AgentHub
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
SERVER_PORT=8240
LOG_LEVEL=INFO
# 普通 API CORS 白名单，逗号分隔。不要复用 EMBED_ALLOWED_PARENT_ORIGINS。
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────
# 2. MySQL 8.0+
# ─────────────────────────────────────────────
# 本地开发：mysql+pymysql://user:password@localhost:3306/agenthub?charset=utf8mb4
# 生产建议：使用 hosts 别名（如 mysql.intra）而非裸 IP，便于迁移；账号最小权限化。
DATABASE_URL=mysql+pymysql://user:password@host:3306/agenthub?charset=utf8mb4
# 单元测试用独立数据库；测试会反复建表删表，**严禁**与开发/生产库共用。
TEST_DATABASE_URL=mysql+pymysql://user:password@host:3306/agenthub_test?charset=utf8mb4

# ─────────────────────────────────────────────
# 3. 密钥（生产强校验，至少 32 字符高强度随机）
# ─────────────────────────────────────────────
# 每个密钥都必须独立生成，不要复用。
API_KEY_SIGNING_SECRET=change-me-to-a-random-secret
# 用于手机号密码登录后的 HttpOnly 会话 token 签名；生产环境必填，禁止占位默认值。
AUTH_TOKEN_SECRET=change-me-to-a-random-secret-at-least-32-chars
# HttpOnly 登录 Cookie 名称，默认 agenthub_session。只有需要自定义时才取消下一行注释。
# AUTH_COOKIE_NAME=agenthub_session
# 纯 HTTP 内网试用为 false；启用 HTTPS（含 IP SAN 证书）后必须改为 true。
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# 直接使用 IP 访问时保持为空，生成 host-only Cookie；不要填写共享 Domain。
AUTH_COOKIE_DOMAIN=

# ─────────────────────────────────────────────
# 4. 产业互联网 iframe 嵌入
# ─────────────────────────────────────────────
# true 启用 /api/v1/embed/exchange、/embed/session、/embed/logout
# 生产首次部署若暂未对接产业互联网，先 false，待真实联调时再开启。
EMBED_ENABLED=true
# 与产业互联网后端共享的 JWT 验签密钥；只允许双方后端持有，绝不下发前端；生产 ≥ 32 字符。
EMBED_EXTERNAL_TOKEN_SECRET=replace-with-random-industrial-embed-token-secret
# 产业互联网 JWT 的 iss / aud，AgentHub 验签时必须匹配。
EMBED_EXTERNAL_TOKEN_ISSUER=industrial-internet
EMBED_EXTERNAL_TOKEN_AUDIENCE=agenthub
# AgentHub 自己的 iframe embed session 有效期（分钟）；token 只用于 exchange，后续请求走该 session Cookie。
EMBED_SESSION_EXPIRE_MINUTES=10
# AgentHub 写给 iframe 的 HttpOnly Cookie 名称，默认 agenthub_embed_session。
# EMBED_SESSION_COOKIE_NAME=agenthub_embed_session
# embed session Cookie 是否只允许 HTTPS 发送。
# 本地 / 内网 HTTP 阶段：false；生产跨站 iframe（必须 HTTPS）：true。
EMBED_COOKIE_SECURE=false
# embed session Cookie SameSite 策略。
# 同站调试：lax；跨站 iframe：none（同时 Secure 必须 true）。
EMBED_COOKIE_SAMESITE=lax
# embed session Cookie Domain；本地为空，生产按 AgentHub 域名策略配置。
EMBED_COOKIE_DOMAIN=
# iframe 默认 Agent code；也用于产业互联网 token 中 agent_code 的默认联调值。
EMBED_DEFAULT_AGENT_CODE=qa
# 首次 exchange 创建 AgentHub 外部客户用户时使用的默认组织名称。
EMBED_DEFAULT_ORG_NAME=官网嵌入用户
# 允许嵌入 AgentHub iframe 的父页面 origin，逗号分隔；仅用于 frame-ancestors 与
# iframe postMessage 父页面校验，不用于普通 API CORS。
EMBED_ALLOWED_PARENT_ORIGINS=

# ─────────────────────────────────────────────
# 5. Dify runtime
# ─────────────────────────────────────────────
# 不填则 Dify 调用失败并返回明确配置错误。
# 自部署 Dify 默认 API 前缀是 /v1；云端 SaaS 为 https://api.dify.ai/v1。
# 内网部署示例（与 hosts 别名搭配）：http://dify.intra:8200/v1
DIFY_BASE_URL=
# 全局兜底 Dify API Key（一般留空）；Agent 级 Key 保存在 agent 配置快照，管理端录入。
DIFY_API_KEY=

# ─────────────────────────────────────────────
# 6. 火山引擎语音（启用语音时必填）
# ─────────────────────────────────────────────
# 未配置时 /audio/speech 与 /audio/transcriptions 返回 503，不影响登录/问答主链路。
VOLC_AUDIO_API_KEY=
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
VOLC_ASR_AUDIO_FORMAT=pcm
VOLC_ASR_SAMPLE_RATE=16000
VOLC_ASR_LANGUAGE=zh-CN
VOLC_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=
VOLC_TTS_AUDIO_FORMAT=mp3
VOLC_TTS_SAMPLE_RATE=24000
