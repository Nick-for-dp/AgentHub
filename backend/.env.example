# AgentHub 环境变量
# 复制此文件为 .env 后修改

# 应用
APP_NAME=AgentHub
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
SERVER_PORT=8240
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://host:6379/0

# API Key 签名密钥（至少 16 字符，需使用高强度随机字符串）
API_KEY_SIGNING_SECRET=change-me-to-a-random-secret

# 产业互联网 iframe 嵌入
# true 表示启用 /api/v1/embed/exchange、/embed/session、/embed/logout。
EMBED_ENABLED=true
# 产业互联网后端用于签发短期用户态 JWT 的共享验签密钥。
# 只允许双方后端持有，不能下发到产业互联网前端或 AgentHub 前端；生产环境至少 32 字符。
EMBED_EXTERNAL_TOKEN_SECRET=replace-with-random-industrial-embed-token-secret
# 产业互联网 JWT 的 iss，AgentHub 验签时必须匹配。
EMBED_EXTERNAL_TOKEN_ISSUER=industrial-internet
# 产业互联网 JWT 的 aud，AgentHub 验签时必须匹配。
EMBED_EXTERNAL_TOKEN_AUDIENCE=agenthub
# AgentHub 自己的 iframe embed session 有效期，单位分钟；token 只用于 exchange，后续请求使用该 session Cookie。
EMBED_SESSION_EXPIRE_MINUTES=10
# AgentHub 写给 iframe 的 HttpOnly Cookie 名称。
EMBED_SESSION_COOKIE_NAME=agenthub_embed_session
# embed session Cookie 是否只允许 HTTPS 发送；生产环境跨站 iframe 应设为 true。
EMBED_COOKIE_SECURE=false
# embed session Cookie SameSite 策略；本地同站调试可用 lax，生产跨站 iframe 通常应使用 none。
EMBED_COOKIE_SAMESITE=lax
# embed session Cookie Domain；本地为空，生产按 AgentHub 域名策略配置。
EMBED_COOKIE_DOMAIN=
# iframe 默认 Agent code；也用于产业互联网 token 中 agent_code 的默认联调值。
EMBED_DEFAULT_AGENT_CODE=qa
# 首次 exchange 创建 AgentHub 外部客户用户时使用的默认组织名称。
EMBED_DEFAULT_ORG_NAME=官网嵌入用户
# 允许嵌入 AgentHub iframe 的父页面 origin，逗号分隔；同时用于 CORS 与 frame-ancestors。
EMBED_ALLOWED_PARENT_ORIGINS=

# Dify（可选，不填则 Q&A 返回 mock 应答）
DIFY_BASE_URL=
DIFY_API_KEY=

# 火山引擎语音（新版控制台，使用 X-Api-Key）
VOLC_AUDIO_API_KEY=
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
VOLC_ASR_AUDIO_FORMAT=pcm
VOLC_ASR_SAMPLE_RATE=16000
VOLC_ASR_LANGUAGE=zh-CN
VOLC_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=
VOLC_TTS_AUDIO_FORMAT=mp3
VOLC_TTS_SAMPLE_RATE=24000
